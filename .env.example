# Copy to .env and change every value before running anywhere other than your laptop.
# docker compose reads .env automatically. Never commit the real .env (it is git-ignored).

POSTGRES_PASSWORD=change-me-postgres

# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SIGNING_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Password for the first "admin" user (created only when the database has no users yet)
ADMIN_PASSWORD=change-me-admin-password

# Seed demo users (analyst / viewer) and demo merchants. Set to false in real environments.
DEMO_DATA=true
DEMO_PASSWORD=settleflow-demo
DEMO_MERCHANT_API_KEY=sf_live_demo0000_local-demo-key-not-a-secret
