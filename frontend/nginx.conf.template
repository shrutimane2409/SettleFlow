server {
    listen 80;
    root /usr/share/nginx/html;
    server_tokens off;

    # Re-resolve the API's address every 10s instead of once at startup, so redeploying the API
    # (new container IP) doesn't leave nginx forwarding to a stale address.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $api_upstream ${API_UPSTREAM};

    # Security headers. inline styles are needed for React style={} props; no inline scripts are allowed.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # The dashboard calls the API on the same origin; nginx forwards to the api container.
    location /api/ {
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The API sets its own security headers; drop them so each header appears once (nginx adds the dashboard's).
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
        # Live event stream (Server-Sent Events): don't buffer.
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location /health {
        proxy_pass $api_upstream;
        # The API sets its own security headers; drop them so each header appears once (nginx adds the dashboard's).
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
    }

    # Hashed build assets can be cached forever.
    # Note: no add_header inside these blocks, otherwise nginx drops the server-level security headers.
    location /assets/ {
        expires 1y;
    }

    location / {
        try_files $uri /index.html;
        expires -1;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
