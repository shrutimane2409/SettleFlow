{
 "uid": "settleflow-slo",
 "title": "SettleFlow SLOs",
 "tags": [
  "settleflow"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "10s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "type": "row",
   "title": "Service level objectives",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": [],
   "id": 1
  },
  {
   "type": "stat",
   "title": "API availability (6h) \u00b7 SLO 99.9%",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "expr": "1 - slo:api_errors:ratio_rate6h",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.995
       },
       {
        "color": "green",
        "value": 0.999
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   },
   "id": 2
  },
  {
   "type": "stat",
   "title": "Error budget remaining (6h window)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "expr": "clamp_min(1 - slo:api_errors:ratio_rate6h / 0.001, 0)",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.25
       },
       {
        "color": "green",
        "value": 0.5
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   },
   "id": 3
  },
  {
   "type": "stat",
   "title": "Settled within 10s (1h) \u00b7 SLO 99%",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "expr": "slo:settled_within_10s:ratio_rate1h",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.95
       },
       {
        "color": "green",
        "value": 0.99
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   },
   "id": 4
  },
  {
   "type": "stat",
   "title": "Create payment p95 \u00b7 SLO 300ms",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "expr": "slo:create_payment_latency:p95_5m",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.2
       },
       {
        "color": "red",
        "value": 0.3
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   },
   "id": 5
  },
  {
   "type": "timeseries",
   "title": "Error budget burn rate (1 = on budget)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "expr": "slo:api_errors:ratio_rate5m / 0.001",
     "legendFormat": "5m",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "expr": "slo:api_errors:ratio_rate1h / 0.001",
     "legendFormat": "1h",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "expr": "slo:api_errors:ratio_rate6h / 0.001",
     "legendFormat": "6h",
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 2,
      "stacking": {
       "mode": "none"
      },
      "thresholdsStyle": {
       "mode": "line+area"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 6
       },
       {
        "color": "red",
        "value": 14.4
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 6
  },
  {
   "type": "timeseries",
   "title": "Time to settle percentiles",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 6,
    "w": 12,
    "h": 9
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum by (le) (rate(settleflow_payment_time_to_settle_seconds_bucket[5m])))",
     "legendFormat": "p50",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "expr": "histogram_quantile(0.99, sum by (le) (rate(settleflow_payment_time_to_settle_seconds_bucket[5m])))",
     "legendFormat": "p99",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 2,
      "stacking": {
       "mode": "none"
      },
      "thresholdsStyle": {
       "mode": "line+area"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 10
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 7
  },
  {
   "type": "timeseries",
   "title": "API requests by status",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{service=\"api\", http_route=~\"/api/.*\"}[1m]))",
     "legendFormat": "{{http_response_status_code}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 2,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "id": 8
  },
